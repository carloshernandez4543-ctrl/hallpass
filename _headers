# Cloudflare Pages response headers.
#
# index.html is already served with max-age=0 and always revalidates.
# /assets was not: it came back with max-age=14400, so for four hours
# after a deploy a returning visitor ran fresh HTML against a stale
# assets/games.js. Every card threw and the grid rendered empty. These
# two files now move together.
#
# /thumbs is the opposite case. A thumbnail is keyed by the game's id
# and its contents never change, so it can be cached for a year.

/assets/*
  Cache-Control: public, max-age=0, must-revalidate

/thumbs/*
  Cache-Control: public, max-age=31536000, immutable
